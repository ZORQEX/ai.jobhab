{
  "name": "ai-jobhub",
  "version": "1.0.0",
  "private": true,
  "description": "AI JobHub — поиск работы с AI-подбором на Firebase Firestore",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.js 8080",
    "lint": "eslint src tests tools",
    "check:firebase": "node tools/check-firebase.mjs",
    "format": "prettier --write \"src/**/*.js\" \"*.json\" \"*.md\"",
    "test:match": "node --test tests/match.test.js",
    "test:components": "node --test tests/components.test.js",
    "test:contract": "node --test tests/contract.test.js",
    "test:plan": "node --test tests/query-plan.test.js",
    "test:unit": "node --test tests/match.test.js tests/components.test.js tests/contract.test.js tests/query-plan.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules.test.js\"",
    "test:storage-rules": "firebase emulators:exec --only storage \"node --test tests/storage-rules.test.js\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:storage-rules",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^9.14.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.29.1",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
